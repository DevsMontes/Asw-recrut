{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'HZ2txmi9fPVzDKvt5f5OomAi1B42' && newData.exists()",
      ".validate": "newData.hasChildren(['status', 'updatedAt', 'updatedBy'])",
      "status": {
        ".validate": "newData.val() === 'fechado'"
      },
      "updatedAt": {
        ".validate": "newData.isNumber() && newData.val() === now"
      },
      "updatedBy": {
        ".validate": "newData.val() === auth.uid"
      },
      "$other": {
        ".validate": "data.exists() && newData.val() === data.val()"
      }
    },
    "aplicacoes": {
      ".read": "auth != null && auth.uid === 'HZ2txmi9fPVzDKvt5f5OomAi1B42'",
      ".write": false
    },
    "garagePosts": {
      ".read": true,
      ".indexOn": ["createdAt"],
      "$id": {
        ".write": "auth != null && auth.uid === 'HZ2txmi9fPVzDKvt5f5OomAi1B42'",
        ".validate": "newData.hasChildren(['title','description','brand','category','fit','tone','images','createdAt','updatedAt','updatedBy'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 3000"
        },
        "brand": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "power": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
        },
        "year": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 20"
        },
        "setup": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 100"
        },
        "category": {
          ".validate": "newData.val() === 'Esportivos' || newData.val() === 'Clássicos' || newData.val() === 'Projetos'"
        },
        "fit": {
          ".validate": "newData.val() === 'contain' || newData.val() === 'cover'"
        },
        "tone": {
          ".validate": "newData.val() === 'dark' || newData.val() === 'light' || newData.val() === 'warm'"
        },
        "images": {
          "0": {
            ".validate": "newData.isString() && newData.val().length <= 420000 && newData.val().matches(/^data:image\\/(webp|png|jpeg);base64,[A-Za-z0-9+\\/=]+$/)"
          },
          "1": {
            ".validate": "newData.isString() && newData.val().length <= 420000 && newData.val().matches(/^data:image\\/(webp|png|jpeg);base64,[A-Za-z0-9+\\/=]+$/) && newData.parent().child('0').exists()"
          },
          "2": {
            ".validate": "newData.isString() && newData.val().length <= 420000 && newData.val().matches(/^data:image\\/(webp|png|jpeg);base64,[A-Za-z0-9+\\/=]+$/) && newData.parent().child('1').exists()"
          },
          "3": {
            ".validate": "newData.isString() && newData.val().length <= 420000 && newData.val().matches(/^data:image\\/(webp|png|jpeg);base64,[A-Za-z0-9+\\/=]+$/) && newData.parent().child('2').exists()"
          },
          ".validate": "newData.hasChildren(['0'])",
          "$other": {
            ".validate": false
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "updatedBy": {
          ".validate": "newData.val() === auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
